{
  "name": "react-native-spline",
  "version": "1.0.0",
  "description": "React Native library to display and run a .splinecode asset into the mobile app using the native ios and android libraries.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "test": "expo-module test",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && bun run typecheck",
    "start:ios": "bun --cwd example expo run:ios",
    "start:android": "bun --cwd example expo run:android",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android",
    "setup:branch-protection": "./scripts/setup-branch-protection.sh"
  },
  "keywords": [
    "expo",
    "expo-module",
    "spline",
    "3d",
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmanuel-defreitas/react-native-spline.git"
  },
  "bugs": {
    "url": "https://github.com/emmanuel-defreitas/react-native-spline/issues"
  },
  "author": "Emmanuel De Freitas <manny.defreitas7@me.com> (https://github.com/emmanuel-defreitas)",
  "license": "MIT",
  "homepage": "https://github.com/emmanuel-defreitas/react-native-spline#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/react": "~19.2.14",
    "conventional-changelog-conventionalcommits": "^9.3.0",
    "expo": "^55.0.8",
    "expo-module-scripts": "^55.0.2",
    "jest": "^29.7.0",
    "react-native": "0.82.1",
    "semantic-release": "^25.0.3",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "@types/jest": "^29.5.14"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "@expo/config-plugins": "55.0.7",
    "@msgpack/msgpack": "^3.1.3",
    "expo-sensors": "^55.0.9"
  },
  "expo": {
    "fyi": {
      "ios.spm": "SplineRuntime must be added via the config plugin. See README."
    }
  },
  "files": [
    "build",
    "plugin/build",
    "android",
    "ios",
    "app.plugin.js",
    "expo-module.config.json",
    "CHANGELOG.md"
  ]
}
