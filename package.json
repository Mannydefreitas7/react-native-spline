{
  "name": "react-native-spline",
  "version": "0.1.0",
  "description": "React Native library to display and run a .splinecode asset into the mobile app using the native ios and android libraries.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "test": "expo-module test",
    "start:ios": "bun --cwd example expo run:ios",
    "start:android": "bun --cwd example expo run:android",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "expo",
    "expo-module",
    "spline",
    "3d",
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/Mannydefreitas7/react-native-spline",
  "bugs": {
    "url": "https://github.com/Mannydefreitas7/react-native-spline/issues"
  },
  "author": "Emmanuel De Freitas <manny.defreitas7@me.com> (https://github.com/Mannydefreitas7)",
  "license": "MIT",
  "homepage": "https://github.com/Mannydefreitas7/react-native-spline#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/react": "~19.2.14",
    "expo": "^55.0.8",
    "expo-module-scripts": "^55.0.2",
    "jest": "^30.3.0",
    "react-native": "0.82.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "@expo/config-plugins": "55.0.7",
    "@msgpack/msgpack": "^3.1.3",
    "expo-sensors": "^55.0.9"
  },
  "expo": {
    "fyi": {
      "ios.spm": "SplineRuntime must be added via the config plugin. See README."
    }
  }
}
