{
  "formatter": {
    "external": {
      "command": "bunx",
      "arguments": [
        "biome",
        "format",
        "--stdin-file-path",
        "{buffer_path}"
      ]
    }
  },
  "format_on_save": "on",
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    }
  },
  "languages": {
    "TypeScript": {
      "language_servers": [
        "biome",
        "typescript-language-server",
        "..."
      ],
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": [
            "biome",
            "format",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
